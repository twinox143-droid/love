    <style>
        /* Core romantic aesthetic and touch-friendly setup */
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #fff0f4 0%, #ffe0e9 50%, #ffccd9 100%);
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        .romantic-title {
            font-family: 'Playfair Display', serif;
        }

        /* Heartbeat animation for the final "I love you ❤️" reveal */
        @keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            15% { transform: scale(1.22); }
            30% { transform: scale(1); }
            45% { transform: scale(1.14); }
            60% { transform: scale(1); }
        }

        .animate-heartbeat {
            display: inline-block;
            animation: heartbeat 2.2s infinite ease-in-out;
        }

        /* Gentle ambient background floating hearts */
        @keyframes bgFloat {
            0% {
                transform: translateY(110vh) scale(0.7) rotate(0deg);
                opacity: 0;
            }
            15% { opacity: 0.45; }
            85% { opacity: 0.45; }
            100% {
                transform: translateY(-15vh) scale(1.1) rotate(25deg);
                opacity: 0;
            }
        }

        .bg-heart {
            position: fixed;
            bottom: -10%;
            pointer-events: none;
            z-index: 0;
            animation: bgFloat linear forwards;
        }

        /* Interactive collectible heart styling */
        .game-heart {
            position: absolute;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translate(-50%, -50%);
            transition: transform 0.1s ease-out;
            filter: drop-shadow(0 6px 12px rgba(244, 63, 94, 0.25));
            z-index: 20;
            padding: 12px; /* Generous touch target padding for mobile */
        }

        .game-heart:active {
            transform: translate(-50%, -50%) scale(0.85);
        }

        /* Golden bonus heart glow */
        .golden-heart {
            filter: drop-shadow(0 0 14px rgba(251, 191, 36, 0.75));
        }

        /* Sparkle / petal burst particle animation */
        @keyframes particleBurst {
            0% {
                transform: translate(-50%, -50%) scale(0.4);
                opacity: 1;
            }
            100% {
                transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1.15) rotate(var(--rot));
                opacity: 0;
            }
        }

        .burst-particle {
            position: absolute;
            pointer-events: none;
            z-index: 30;
            animation: particleBurst 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Floating +1 / +2 score popup */
        @keyframes scoreFloat {
            0% {
                transform: translate(-50%, -50%) scale(0.7);
                opacity: 1;
            }
            100% {
                transform: translate(-50%, -140%) scale(1.1);
                opacity: 0;
            }
        }

        .score-popup {
            position: absolute;
            pointer-events: none;
            z-index: 35;
            font-weight: 700;
            animation: scoreFloat 0.8s ease-out forwards;
        }

        /* Victory confetti celebration */
        @keyframes confettiFall {
            0% {
                transform: translateY(-10vh) rotate(0deg) scale(0.8);
                opacity: 1;
            }
            100% {
                transform: translateY(110vh) rotate(540deg) scale(1.1);
                opacity: 0;
            }
        }

        .confetti-item {
            position: fixed;
            top: -5%;
            pointer-events: none;
            z-index: 45;
            animation: confettiFall linear forwards;
        }

        /* Smooth screen transitions */
        .screen-panel {
            transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .screen-hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.95) translateY(10px);
            position: absolute;
        }

        .screen-active {
            opacity: 1;
            pointer-events: auto;
            transform: scale(1) translateY(0);
            position: relative;
        }
